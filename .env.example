# Auth.js / GitHub OAuth App
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_OWNER_LOGIN=

# Server-only Supabase access (Singapore region recommended)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fine-grained GitHub token: Starring read/write, Metadata read
GITHUB_TOKEN=

# GitHub 下载加速前缀；填 direct 可关闭代理
GITHUB_DOWNLOAD_PROXY=https://gh-proxy.com/

# Vercel Cron and manual sync protection
CRON_SECRET=

# AI 整理（可选）：支持 OpenAI、Anthropic、Gemini 三种接口格式，默认按 DeepSeek 渠道配置
# OpenAI 格式填到 /v1 为止，也可以直接填完整的 /chat/completions 地址；Anthropic 格式填 SDK 地址（不含 /v1）；Gemini 格式可以只填域名
# 保留 <...> 占位符时视为未配置
AI_BASE_URL=<YOUR_AI_BASE_URL>
AI_API_KEY=<YOUR_AI_API_KEY>
# 可选：deepseek（默认）、openai、anthropic（或 claude）、gemini（或 google），其他任意名称按通用 OpenAI 兼容接口处理
# 不填时按地址识别：api.openai.com、api.anthropic.com（以及 /anthropic 路径）、generativelanguage.googleapis.com
AI_PROVIDER=
# 可选：默认 deepseek-flash、gpt-6-luna、claude-opus-5-5、gemini-3.5-flash-lite；其他兼容接口必须填写
AI_MODEL=
# 可选：推理强度，如 none、minimal、low、medium、high、xhigh、max；默认 low，DeepSeek 默认关闭思考、填写后开启
AI_REASONING_EFFORT=
